# Reglas comunes a los dos proyectos. Cada subcarpeta conserva su propio
# .gitignore (backend/.gitignore y frontend/app-complejo/.gitignore) y esas
# reglas siguen valiendo: git las lee en cascada, de la raíz hacia adentro.

# Dependencias y compilados
node_modules/
dist/
build/
*.tsbuildinfo

# Variables de entorno: nunca versionar credenciales.
# El .env.example del backend sí se versiona, porque no tiene valores reales.
.env
.env.local
.env.*.local

# Caché del build de Angular
.angular/

# Logs y cobertura
*.log
logs/
coverage/

# Sistema operativo
.DS_Store
Thumbs.db

# Ajustes locales del editor / Claude Code
.claude/settings.local.json
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
