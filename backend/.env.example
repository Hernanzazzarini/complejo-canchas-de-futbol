# Copiar a .env y completar. El .env real no se versiona.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=complejo_futbol

# Firma de los JWT
JWT_SECRET=cambiar_este_valor
# Formato ms: '1d', '12h', '30m'. Por defecto 1d.
JWT_EXPIRES_IN=1d

# Puerto de la API (por defecto 3000)
PORT=3000

# Admin que crea el seed en el primer arranque, si ese email todavía no existe.
ADMIN_EMAIL=hernan.admin@complejo.com
ADMIN_PASSWORD=devreduccion
